    "print(f\"Исходный merged_df: {len(merged_df)} строк\")\n",
    "\n",
    "enriched_df = join_timeseries_to_tabular(merged_df, all_timeseries_dfs)\n",
    "\n",
    "print(f\"\\n=== ИТОГ ===\")\n",
    "print(f\"Исходные строки: {len(merged_df)}\")\n",
    "print(f\"Строк после обогащения: {len(enriched_df)}\")\n",
    "print(f\"Усредненное количество записей на пациента: {len(enriched_df)/len(merged_df['Код пациента_norm'].unique()):.1f}\")"
   ]
