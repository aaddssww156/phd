  {
   "cell_type": "markdown",
   "id": "merge_with_timeseries",
   "metadata": {},
   "source": [
    "### 🆕 Слияние с данными временных рядов\n\nТеперь объединим табличные данные (`merged_df`) с данными временных рядов из файлов `202*.xlsx`.\n\n**Источник данных:** файлы `./data_raw/time_series/202*.xlsx` содержат несколько листов с колонкой `merge_ids`.\n\n**Колонка связи:** `Код пациента_norm` (из merged_df) ↔ `merge_ids` (из файлов временных рядов)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load_xls_sheets",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "time_series_dir = './data_raw/time_series/'\n",
    "year_files = {\n",
    "    '2020': '2020.xlsx',\n",
    "    '2021': '2021.xlsx',\n",
    "    '2022': '2022.xlsx',\n",
    "    '2023': '2023.xlsx',\n",
    "    '2024': '2024.xlsx',\n",
    "    '2025': '2025.xlsx'\n",
    "}\n",
    "\n",
    "# Загружаем все листы из всех файлов\n",
    "all_timeseries_dfs = []\n",
    "\n",
    "for year, filename in year_files.items():\n",
    "    filepath = os.path.join(time_series_dir, filename)\n",
    "    if os.path.exists(filepath):\n",
    "        xls = pd.ExcelFile(filepath)\n",
    "        sheets = xls.sheet_names\n",
    "        print(f\"\\n{year} ({filename}):\")\n",
    "        print(f\"  Листы: {sheets}\")\n",
    "        \n",
    "        # Читаем все листы\n",
    "        for sheet_name in sheets:\n",
    "            df = pd.read_excel(filepath, sheet_name=sheet_name)\n",
    "            if 'merge_ids' in df.columns:\n",
    "                df['source_sheet'] = f\"{year}_{sheet_name}\"\n",
    "                df['merge_ids_clean'] = df['merge_ids'].astype(str).str.replace(' ', '', regex=False).str.strip()\n",
    "                all_timeseries_dfs.append(df)\n",
    "                print(f\"    - {sheet_name}: {len(df)} строк\")\n",
    "            else:\n",
    "                print(f\"    - {sheet_name}: нет колонки merge_ids\")\n",
    "    else:\n",
    "        print(f\"\\n{year} ({filename}): файл не найден\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "normalize_merge_ids",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Нормализация merge_ids для всех датасетов временных рядов\n",
    "print(\"=== Нормализация merge_ids ===\")\n",
    "\n",
    "for i, df in enumerate(all_timeseries_dfs):\n",
    "    # Создаем нормализованную колонку если не существует\n",
    "    if 'merge_ids_clean' not in df.columns:\n",
    "        df['merge_ids_clean'] = df['merge_ids'].astype(str).str.replace(' ', '', regex=False).str.strip()\n",
    "    print(f\"{df['source_sheet'].iloc[0]}: merge_ids тип={df['merge_ids'].dtype}, нормализованный тип={df['merge_ids_clean'].dtype}\")\n",
    "    print(f\"  Примеры: {df['merge_ids_clean'].head(3).tolist()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "merge_logic",
   "metadata": {},
   "source": [
    "### Логика объединения\n\n1. Берем `merged_df` (табличные данные с пациентами)\n2. Для каждого нормализованного `Код пациента_norm` ищем совпадения в `merge_ids_clean` временных рядов\n3. Объединяем временные измерения с табличными данными"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "join_timeseries",
   "metadata": {},
   "outputs": [],
   "source": [
    "def join_timeseries_to_tabular(tabular_df, timeseries_list):\n",
    "    \"\"\"\n",
    "    Объединяет табличные данные с временными рядами\n",
    "    Табличная строка + все временные записи для этого пациента\n",
    "    \"\"\"\n",
    "    result_dfs = []\n",
    "    \n",
    "    # Получаем уникальные коды пациентов из табличных данных\n",
    "    patient_codes = tabular_df['Код пациента_norm'].unique()\n",
    "    print(f\"\\nОбрабатываем {len(patient_codes)} уникальных пациентов\")\n",
    "    \n",
    "    for patient_code in patient_codes:\n",
    "        # Находим соответствующие строки табличных данных\n",
    "        tabular_rows = tabular_df[tabular_df['Код пациента_norm'] == patient_code]\n",
    "        \n",
    "        # Находим соответствующие временные записи\n",
    "        ts_rows = []\n",
    "        for ts_df in timeseries_list:\n",
    "            matches = ts_df[ts_df['merge_ids_clean'] == patient_code]\n",
    "            ts_rows.append(matches)\n",
    "        \n",
    "        # Объединяем все временные записи\n",
    "        if ts_rows:\n",
    "            ts_combined = pd.concat(ts_rows, ignore_index=True)\n",
    "            print(f\"{patient_code}: {len(ts_combined)} временных записей\")\n",
    "            \n",
    "            # Для каждой записи временных рядов создаем полную строку\n",
    "            for ts_idx in range(len(ts_combined)):\n",
    "                # Копируем табличные данные\n",
    "                full_row = tabular_rows.iloc[0].copy()\n",
    "                \n",
    "                # Добавляем колонку с меткой временной записи\n",
    "                full_row['ts_record_id'] = ts_idx\n",
    "                full_row['ts_sheet'] = ts_combined.iloc[ts_idx]['source_sheet']\n",
    "                \n",
    "                # Добавляем все колонки из временных рядов (кроме ключевых)\n",
    "                ts_record = ts_combined.iloc[ts_idx].to_dict()\n",
    "                for key, value in ts_record.items():\n",
    "                    if key not in full_row.index:\n",
    "                        full_row[key] = value\n",
    "                    else:\n",
    "                        # Если колонка уже есть, добавляем префикс\n",
    "                        full_row[f'ts_{key}'] = value\n",
    "                \n",
    "                result_dfs.append(full_row)\n",
    "    \n",
    "    return pd.DataFrame(result_dfs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "perform_join",
