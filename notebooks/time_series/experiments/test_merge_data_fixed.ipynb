   "source": [
    "### Попытки мерджа двух датасетов - временные ряды и табличные данные\n",
    "\n",
    "**Зачем** - датасет с табличными данными содержит основную информацию о пациенте, исход и временные рамки лечения. Это потребуется для создания модели прогноза временных рядов. \n",
    "Так же, в будущем табличный датасет может быть обогащен информацией от временных рядов для лучшей классификации исхода. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8c73f994",
   "metadata": {},
   "outputs": [],
   "source": [
    "table_data = pd.read_excel(\"./data_raw/DataSet_V49 (2).xlsx\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6ec5d12b",
   "metadata": {},
   "outputs": [],
   "source": [
    "time_series_data = pd.read_excel(\"./data_raw/data-timeseries_test.xlsx\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0a088f4a",
   "metadata": {},
   "outputs": [],
   "source": [
    "time_series_data[\"chartTime\"] = pd.to_datetime(time_series_data[\"chartTime\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1b1bfc70",
   "metadata": {},
   "source": [
    "### Нормализация данных\n",
    "\n",
    "Создаём нормализованные версии ключевых колонок для точного совпадения:\n",
    "- Удаляем все пробелы\n",
    "- Преобразуем в строки\n",
    "- Приводим к нижнему регистру (для единообразия)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "norm1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Примеры нормализованных кодов из table_data:\n",
      "['20-6545', '19-22109', '17-13439', '16-20326', '9993', '155', '1144', '153', '1263', '599']\n"
     ]
    }
   ],
   "source": [
    "# Нормализация table_data\n",
    "table_data_copy = table_data.copy()\n",
    "table_data_copy[\"Код пациента_norm\"] = (\n",
    "    table_data_copy[\"Код пациента\"]\n",
    "    .astype(str)\n",
    "    .str.replace(\" \", \"\", regex=False)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "# Проверка нормализации\n",
    "print(\"Примеры нормализованных кодов из table_data:\")\n",
    "print(table_data_copy[\"Код пациента_norm\"].head(10).tolist())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bc5b7bb0",
   "metadata": {},
   "source": [
    "### Загрузка data files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "05e79760",
   "metadata": {},
   "outputs": [],
   "source": [
    "time_2020 = pd.read_excel(\"./data_raw/time_series/2020.xlsx\")\n",
    "time_2021 = pd.read_excel(\"./data_raw/time_series/2021.xlsx\")\n",
    "time_2022 = pd.read_excel(\"./data_raw/time_series/2022.xlsx\")\n",
    "time_2023 = pd.read_excel(\"./data_raw/time_series/2023.xlsx\")\n",
    "time_2024 = pd.read_excel(\"./data_raw/time_series/2024.xlsx\")\n",
    "time_2025 = pd.read_excel(\"./data_raw/time_series/2025.xlsx\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "norm_check",
   "metadata": {},
   "source": [
    "### Нормализация time series data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "norm2020",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2020: Нормализация завершена. Первый нормализованный код: 20-10652\n",
      "2021: Нормализация завершена. Первый нормализованный код: 21-10\n",
      "2022: Нормализация завершена. Первый нормализованный код: 22-10\n",
      "2023: Нормализация завершена. Первый нормализованный код: 23-10341\n",
      "2024: Нормализация завершена. Первый нормализованный код: 24-25444(1)\n",
      "2025: Нормализация завершена. Первый нормализованный код: 25-1\n"
     ]
    }
   ],
   "source": [
    "def normalize_time_series(df, year):\n",
    "    \"\"\"Нормализует датафрейм временных рядов\"\"\"\n",
    "    df_copy = df.copy()\n",
    "    df_copy[\"№иб_norm\"] = (\n",
    "        df_copy[\"№иб\"]\n",
    "        .astype(str)\n",
    "        .str.replace(\" \", \"\", regex=False)\n",
    "        .str.strip()\n",
    "    )\n",
    "    print(f\"{year}: Нормализация завершена. Первый нормализованный код: {df_copy['№иб_norm'].iloc[0] if not df_copy.empty else 'N/A'}\")\n",
    "    return df_copy\n",
    "\n",
    "time_2020_norm = normalize_time_series(time_2020, \"2020\")\n",
    "time_2021_norm = normalize_time_series(time_2021, \"2021\")\n",
    "time_2022_norm = normalize_time_series(time_2022, \"2022\")\n",
    "time_2023_norm = normalize_time_series(time_2023, \"2023\")\n",
    "time_2024_norm = normalize_time_series(time_2024, \"2024\")\n",
    "time_2025_norm = normalize_time_series(time_2025, \"2025\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bc5b7bb1",
   "metadata": {},
   "source": [
    "### Функция для поиска совпадений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "merge_func",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "=== Выполнение мерджа ===\n",
      "2020: Найдено 767 строк\n",
      "2021: Найдено 1479 строк\n",
      "2022: Найдено 620 строк\n",
      "2023: Найдено 726 строк\n",
      "2024: Найдено 1284 строк\n",
      "2025: Совпадений не найдено\n"
     ]
    }
   ],
   "source": [
    "def merge_by_year(table_df, time_df, year):\n",
    "    \"\"\"Сливает табличный датасет с датафреймом временных рядов по нормализованному коду пациента\"\"\"\n",
    "    result_dfs = []\n",
    "    \n",
    "    for val in time_df[\"№иб_norm\"].values:\n",
    "        # Точное совпадение по нормализованным значениям\n",
    "        filtered = table_df[table_df[\"Код пациента_norm\"] == val]\n",
    "        if not filtered.empty:\n",
    "            filtered = filtered.copy()\n",
    "            filtered[\"source_year\"] = year\n",
    "            filtered[\"match\"] = val\n",
    "            result_dfs.append(filtered)\n",
    "    \n",
    "    if result_dfs:\n",
    "        final_df = pd.concat(result_dfs, ignore_index=True)\n",
    "        print(f\"{year}: Найдено {len(final_df)} строк\")\n",
    "        return final_df\n",
    "    else:\n",
    "        print(f\"{year}: Совпадений не найдено\")\n",
    "        return None\n",
    "\n",
    "# Проведем мердж для каждого года\n",
    "print(\"\\n=== Выполнение мерджа ===\")\n",
    "final_df_2020 = merge_by_year(table_data_copy, time_2020_norm, \"2020\")\n",
    "final_df_2021 = merge_by_year(table_data_copy, time_2021_norm, \"2021\")\n",
    "final_df_2022 = merge_by_year(table_data_copy, time_2022_norm, \"2022\")\n",
    "final_df_2023 = merge_by_year(table_data_copy, time_2023_norm, \"2023\")\n",
    "final_df_2024 = merge_by_year(table_data_copy, time_2024_norm, \"2024\")\n",
    "final_df_2025 = merge_by_year(table_data_copy, time_2025_norm, \"2025\")"
   ]
  },
  {
