   "source": [
    "# Фильтруем только существующие датафреймы\n",
    "all_dfs = [df for df in [final_df_2020, final_df_2021, final_df_2022, final_df_2023, final_df_2024, final_df_2025] if df is not None]\n",
    "\n",
    "if all_dfs:\n",
    "    merged_df = pd.concat(all_dfs, ignore_index=True)\n",
    "    print(f\"\\n=== ИТОГО ===\")\n",
    "    print(f\"Всего строк в merged_df: {len(merged_df)}\")\n",
    "    print(f\"Количество уникальных пациентов: {merged_df['Код пациента_norm'].nunique()}\")\n",
    "else:\n",
    "    print(\"\\nНет совпадений ни за один год\")\n",
    "    merged_df = pd.DataFrame()"
